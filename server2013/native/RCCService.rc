#include <windows.h>
1 ICON "rcc2013.ico"
1 VERSIONINFO
FILEVERSION 0,1,0,0
PRODUCTVERSION 0,1,0,0
FILEFLAGSMASK 0x3fL
FILEFLAGS 0
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904B0"
        BEGIN
            VALUE "CompanyName", "RCC2013 Project"
            VALUE "FileDescription", "Custom RCC2013 Service"
            VALUE "FileVersion", "0.1.0"
            VALUE "InternalName", "RCCService"
            VALUE "OriginalFilename", "RCCService.exe"
            VALUE "ProductName", "RCC2013 Custom RCC"
            VALUE "ProductVersion", "0.1.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0409, 1200
    END
END
